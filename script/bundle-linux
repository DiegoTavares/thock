#!/usr/bin/env bash

set -euxo pipefail
source script/lib/blob-store.sh

# Function for displaying help info
help_info() {
  echo "
Usage: ${0##*/} [options]
Build a release .tar.gz for Linux.

Options:
  -h, --help     Display this help and exit.
  --flatpak      Set ZED_BUNDLE_TYPE=flatpak so that this can be included in system info
  "
}

# Parse all arguments manually
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            help_info
            exit 0
            ;;
        --flatpak)
            export ZED_BUNDLE_TYPE=flatpak
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            help_info
            exit 1
            ;;
        *)
            echo "Error: Unexpected argument: $1" >&2
            help_info
            exit 1
            ;;
    esac
done

export ZED_BUNDLE=true

# Thock: the release workflow pre-sets ZED_RELEASE_CHANNEL=stable; local builds
# fall back to the committed RELEASE_CHANNEL file (dev), which never polls for
# updates. Release binaries compile the channel in via include_str!, so a
# pre-set value has to be written through to the file before the build.
if [[ -n "${ZED_RELEASE_CHANNEL:-}" ]]; then
    channel="${ZED_RELEASE_CHANNEL}"
    if [[ "${channel}" != "$(<crates/thock_app/RELEASE_CHANNEL)" ]]; then
        echo "${channel}" > crates/thock_app/RELEASE_CHANNEL
    fi
else
    channel=$(<crates/thock_app/RELEASE_CHANNEL)
fi
target_dir="${CARGO_TARGET_DIR:-target}"

version="$(script/get-crate-version thock_app)"
# Set RELEASE_VERSION so it's compiled into GPUI and it knows about the version.
export RELEASE_VERSION="${version}"

commit=$(git rev-parse HEAD | cut -c 1-7)

version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }

# Generate the licenses first, so they can be baked into the binaries
script/generate-licenses

export CC=${CC:-$(which clang)}

# Build binary in release mode
# NOTE: Since RUSTFLAGS env var overrides all .cargo/config.toml rustflags
# (see https://github.com/rust-lang/cargo/issues/5376), the
# [target.aarch64-unknown-linux-gnu] section in config.toml has no effect here.
if [[ "$(uname -m)" == "aarch64" ]]; then
    export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-fuse-ld=lld -C link-args=-Wl,--disable-new-dtags,-rpath,\$ORIGIN/../lib"
else
    export RUSTFLAGS="${RUSTFLAGS:-} -C link-args=-Wl,--disable-new-dtags,-rpath,\$ORIGIN/../lib"
fi
cargo build --release --target "${target_triple}" --package thock_app --package cli

# Strip debug symbols.
# We use llvm-objcopy because GNU objcopy on older distros (e.g. Ubuntu 20.04)
# doesn't understand CREL sections produced by newer LLVM.
llvm-objcopy --strip-debug "${target_dir}/${target_triple}/release/thock"
llvm-objcopy --strip-debug "${target_dir}/${target_triple}/release/cli"

suffix=""
if [ "$channel" != "stable" ]; then
  suffix="-$channel"
fi

# Move everything that should end up in the final package
# into a temp directory. Thock ships a single channel, so the package layout
# carries no channel suffix even though the icon assets still do.
temp_dir=$(mktemp -d)
app_dir="${temp_dir}/thock.app"

# Binary
mkdir -p "${app_dir}/bin" "${app_dir}/libexec"
cp "${target_dir}/${target_triple}/release/thock" "${app_dir}/libexec/thock-editor"
cp "${target_dir}/${target_triple}/release/cli" "${app_dir}/bin/thock"

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd ${target_dir}/${target_triple}/release/thock |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${app_dir}/lib"
rm -rf "${app_dir}/lib/*"
cp $(find_libs) "${app_dir}/lib"

# Icons
icon_suffix="$suffix"
mkdir -p "${app_dir}/share/icons/hicolor/512x512/apps"
cp "crates/thock_app/resources/app-icon$icon_suffix.png" "${app_dir}/share/icons/hicolor/512x512/apps/thock.png"
mkdir -p "${app_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/thock_app/resources/app-icon$icon_suffix@2x.png" "${app_dir}/share/icons/hicolor/1024x1024/apps/thock.png"

# .desktop
# APP_ID has to keep matching `ReleaseChannel::app_id`, which Wayland and X11
# use to pair the running window with this desktop entry.
export DO_STARTUP_NOTIFY="true"
export APP_CLI="thock"
export APP_ICON="thock"
export APP_ARGS="%U"
export APP_NAME="Thock"
if [[ "$channel" == "preview" ]]; then
  APP_ID="com.thethock.Thock-Preview"
elif [[ "$channel" == "dev" ]]; then
  APP_ID="com.thethock.Thock-Dev"
else
  APP_ID="com.thethock.Thock"
fi

mkdir -p "${app_dir}/share/applications"
envsubst < "crates/thock_app/resources/thock.desktop.in" > "${app_dir}/share/applications/$APP_ID.desktop"
chmod +x "${app_dir}/share/applications/$APP_ID.desktop"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${app_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="thock-linux-${arch}.tar.gz"

rm -rf "${archive}"
remove_match="thock(-[a-zA-Z0-9]+)?-linux-$(uname -m)\.tar\.gz"
ls "${target_dir}/release" | grep -E ${remove_match} | xargs -d "\n" -I {} rm -f "${target_dir}/release/{}" || true
tar -czvf "${target_dir}/release/$archive" -C ${temp_dir} "thock.app"
