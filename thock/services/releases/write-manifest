#!/usr/bin/env python3
"""Emit a Thock channel manifest (spec: thock/specs/v20-auto-update.md §7).

Usage: BUCKET=thock-releases write-manifest <tag> <artifact-dir> > manifest.json

Maps each artifact filename to its (os, arch), hashes it, and prints the
manifest JSON on stdout. An artifact whose name matches nothing is a hard
error, not a skipped line — silently dropping one is how half the fleet gets
an update and the other half doesn't.
"""

import datetime
import hashlib
import json
import os
import re
import sys

# The filename contract with script/bundle-mac and script/bundle-linux.
ARTIFACT_PLATFORMS = {
    "Thock-aarch64.dmg": ("macos", "aarch64"),
    "Thock-x86_64.dmg": ("macos", "x86_64"),
    "thock-linux-x86_64.tar.gz": ("linux", "x86_64"),
    "thock-linux-aarch64.tar.gz": ("linux", "aarch64"),
}

NOTES_URL_TEMPLATE = "https://github.com/DiegoTavares/thock/releases/tag/{tag}"


def fail(message):
    print(f"write-manifest: {message}", file=sys.stderr)
    sys.exit(1)


def sha256_of(path):
    digest = hashlib.sha256()
    with open(path, "rb") as artifact:
        for chunk in iter(lambda: artifact.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def main():
    if len(sys.argv) != 3:
        fail(f"usage: {os.path.basename(sys.argv[0])} <tag> <artifact-dir>")
    tag, artifact_dir = sys.argv[1], sys.argv[2]

    bucket = os.environ.get("BUCKET")
    if not bucket:
        fail("BUCKET environment variable is required (the GCS bucket artifacts upload to)")

    if not re.fullmatch(r"v\d+\.\d+\.\d+", tag):
        fail(f"tag {tag!r} is not a vMAJOR.MINOR.PATCH version tag")
    version = tag[1:]

    if not os.path.isdir(artifact_dir):
        fail(f"{artifact_dir!r} is not a directory")

    assets = []
    for name in sorted(os.listdir(artifact_dir)):
        path = os.path.join(artifact_dir, name)
        if not os.path.isfile(path):
            fail(f"unexpected non-file in artifact dir: {name!r}")
        platform = ARTIFACT_PLATFORMS.get(name)
        if platform is None:
            fail(
                f"unrecognized artifact {name!r}; known names: "
                + ", ".join(sorted(ARTIFACT_PLATFORMS))
            )
        operating_system, arch = platform
        assets.append(
            {
                "asset": "thock",
                "os": operating_system,
                "arch": arch,
                "url": f"https://storage.googleapis.com/{bucket}/dist/{tag}/{name}",
                "sha256": sha256_of(path),
            }
        )

    if not assets:
        fail(f"no artifacts found in {artifact_dir!r}")

    manifest = {
        "version": version,
        "released_at": datetime.datetime.now(datetime.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
        .replace("+00:00", "Z"),
        "notes_url": NOTES_URL_TEMPLATE.format(tag=tag),
        "assets": assets,
    }
    json.dump(manifest, sys.stdout, indent=2)
    print()


if __name__ == "__main__":
    main()
